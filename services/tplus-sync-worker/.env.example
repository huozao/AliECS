# Placeholder values only. Do not commit real AppKey, AppSecret, openToken, certificate, or appTicket.
CHANJET_BASE_URL=https://openapi.chanjet.com
CHANJET_APP_KEY=your_app_key_here
CHANJET_APP_SECRET=your_app_secret_here
CHANJET_OPEN_TOKEN=your_open_token_here

DEFAULT_PAGE_SIZE=500
# BOM 单独一档：bom/QueryPage 每行展开整棵子件树，服务端耗时随 PageSize 超线性
# （2026-08-09 实测 500→38.5s，超过下面的读超时；50→单页 7~11s）。其余模块继续用 500。
TPLUS_BOM_PAGE_SIZE=50
REQUEST_TIMEOUT_CONNECT=5
REQUEST_TIMEOUT_READ=30

OUTPUT_DIR=output
DATA_DIR=data

# Long-running worker loop interval. The first sync runs immediately.
TPLUS_SYNC_INTERVAL_SECONDS=86400
