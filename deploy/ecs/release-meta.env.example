# Copy this file to /root/AliECS/deploy/ecs/release-meta.env and then edit values.
# If your ECS project directory is not /root/AliECS, update all paths below.
# release-meta.env is server-private config. Do not commit the real file.

APP_ROOT=/root/AliECS
COMPOSE_FILE=/root/AliECS/deploy/ecs/compose.prod.yml
RUNTIME_ENV_FILE=/root/AliECS/deploy/ecs/runtime.env
METADATA_DIR=/root/AliECS/deploy/ecs/.release-meta
MIGRATIONS_DIR=/root/AliECS/db/migrations

HEALTHCHECK_URL=http://127.0.0.1:8000/readyz
HEALTHCHECK_RETRIES=20
HEALTHCHECK_INTERVAL_SECONDS=3
DEPLOY_LOG_DIR=/root/AliECS/deploy/ecs/logs

GHCR_BASE=ghcr.io/huozao

# Required only when GHCR packages are private. Use a PAT with read:packages.
GHCR_USERNAME=
GHCR_TOKEN=

POSTGRES_USER=app
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=app
DATABASE_URL=postgresql://app:replace_with_strong_password@postgres:5432/app

# Generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=replace_with_secure_random_secret
AUTH_TOKEN_TTL_SECONDS=28800

# Generate independently from FORMULA_API_TOKEN; shared only with the WeChat cloud function env.
MINIAPP_SERVICE_TOKEN=replace_with_secure_random_secret

# Host backup jobs report results to backend-api with this independent machine token.
BACKUP_REPORT_TOKEN=replace_with_secure_random_secret

# Used only when the users table is empty.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace_with_secure_password
ADMIN_BOOTSTRAP_DISPLAY_NAME=系统管理员

COUPLE_FEATURE_ENABLED=false
COUPLE_ROUTE=/couple/
COUPLE_ALLOWED_USERS=
COUPLE_ALLOWED_EMAILS=

# APP_BASE_URL / SHARE_BASE_URL: the public origin of this deployment, e.g.
# https://your-domain.example. Required for absolute share links, the ops
# health dashboard's HTTP probes, and any Feishu/WeCom webhook callback that
# needs to advertise its own public URL. Leave blank only if you accept
# same-origin relative links and no external callbacks.
APP_BASE_URL=
SHARE_BASE_URL=
# OPS_HEALTH_*_URL drive the rows in the ops health dashboard. Set both to the
# same origin as APP_BASE_URL (or omit to hide those rows).
OPS_HEALTH_BACKEND_URL=
OPS_HEALTH_PUBLIC_WEB_URL=

STORAGE_DRIVER=webdock
LOCAL_UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=15
WEBDOCK_PHOTO_BASE_URL=http://host.docker.internal:11800
WEBDOCK_PHOTO_API_TOKEN=
WEBDOCK_PHOTO_TIMEOUT_SECONDS=30
IMMICH_ENABLED=false
# IMMICH_BASE_URL: where backend-api reaches Immich. In prod we use the
# reverse-tunnel proxy (http://host.docker.internal:12283); for a different
# deployment, point it at your Immich origin (private URL preferred).
IMMICH_BASE_URL=
IMMICH_API_KEY=
IMMICH_TIMEOUT_SECONDS=20
IMMICH_PROXY_MODE=backend

# WeCom smartsheet sync. Real values stay only on ECS.
WECOM_ENV_PROFILES=COMPANY_A,COMPANY_B
WECOM_COMPANY_A_CORP_ID=
WECOM_COMPANY_A_APP_SECRET=
WECOM_COMPANY_A_APP_SECRET_2=
WECOM_COMPANY_A_APP_SECRETS=
WEDOC_COMPANY_A_DOCID=
WEDOC_COMPANY_A_NAME=
WEDOC_COMPANY_A_SHEET_ID=
WEDRIVE_COMPANY_A_SPACEIDS=
SMARTSHEET_COMPANY_A_ID=
SMARTSHEET_COMPANY_A_NAME=
SMARTSHEET_COMPANY_A_SHEET_ID=
WECOM_COMPANY_B_CORP_ID=
WECOM_COMPANY_B_APP_SECRET=
WECOM_COMPANY_B_APP_SECRET_2=
WECOM_COMPANY_B_APP_SECRETS=
WEDOC_COMPANY_B_DOCID=
WEDOC_COMPANY_B_NAME=
WEDOC_COMPANY_B_SHEET_ID=
WEDRIVE_COMPANY_B_SPACEIDS=
SMARTSHEET_COMPANY_B_ID=
SMARTSHEET_COMPANY_B_NAME=
SMARTSHEET_COMPANY_B_SHEET_ID=

# 创建智能表格副本时的文档管理员 userid（逗号分隔，必填才能用"创建副本"）
WECOM_DOC_ADMIN_USERS=

# Feishu bitable sync. Real values stay only on ECS/KMS.
FEISHU_ENV_PROFILES=COMPANY_A
FEISHU_COMPANY_A_APP_ID=
FEISHU_COMPANY_A_APP_SECRET=
FEISHU_COMPANY_A_APP_TOKEN=
FEISHU_COMPANY_A_TABLE_ID=
FEISHU_COMPANY_A_VIEW_ID=
FEISHU_COMPANY_A_WIKI_NODE_TOKEN=
FEISHU_COMPANY_A_WIKI_URL=
FEISHU_COMPANY_A_APP_NAME=
FEISHU_COMPANY_A_TABLE_NAME=
FEISHU_COMPANY_B_APP_ID=
FEISHU_COMPANY_B_APP_SECRET=
FEISHU_COMPANY_B_APP_TOKEN=
FEISHU_COMPANY_B_TABLE_ID=
FEISHU_COMPANY_B_VIEW_ID=
FEISHU_COMPANY_B_WIKI_NODE_TOKEN=
FEISHU_COMPANY_B_WIKI_URL=
FEISHU_COMPANY_B_APP_NAME=
FEISHU_COMPANY_B_TABLE_NAME=

# Chanjet webhook gateway placeholders only. Real values stay only on ECS.
CHANJET_BASE_URL=https://openapi.chanjet.com
CHANJET_APP_KEY=
CHANJET_APP_SECRET=
CHANJET_OPEN_TOKEN=
CHANJET_WEBHOOK_AES_KEY=
# 自建应用证书：配合 webhook 推送的 appTicket 自动换取 openToken 并写入共享卷 token 文件
CHANJET_CERTIFICATE=
CHANJET_EVENT_SPOOL_DIR=/tmp/aliecs-integration-events/chanjet
CHANJET_AUTO_EXCHANGE_OAUTH_CODE=false

# T+ sync worker. The first run starts immediately, then repeats by interval.
DEFAULT_PAGE_SIZE=500
REQUEST_TIMEOUT_CONNECT=5
# currentStock/Query 偶尔响应超过 30s，读超时建议 90
REQUEST_TIMEOUT_READ=90
TPLUS_SYNC_INTERVAL_SECONDS=86400
RECIPE_ACTIVE_BOM_DIR=/app/recipe-active-bom

# Makes the ECS reverse SSH tunnel reachable from Docker containers through host.docker.internal.
WEBDOCK_TUNNEL_PROXY_ENABLED=true
WEBDOCK_TUNNEL_PROXY_BIND_HOST=172.17.0.1
WEBDOCK_TUNNEL_PROXY_BIND_PORT=11800
WEBDOCK_TUNNEL_PROXY_TARGET_HOST=127.0.0.1
WEBDOCK_TUNNEL_PROXY_TARGET_PORT=11800
WEBDOCK_TUNNEL_PROXY_BACKLOG=64

# Immich photo library integration (private path: browser -> backend -> Immich).
# Immich runs on the old laptop; a reverse SSH tunnel exposes it on ECS 127.0.0.1:12283.
# IMMICH_TUNNEL_PROXY_ENABLED installs a proxy so the backend container reaches it via
# host.docker.internal:12283 (no public DNS/TLS needed). Put the real IMMICH_API_KEY only
# in the server-private release-meta.env; never commit it.
IMMICH_ENABLED=false
IMMICH_BASE_URL=http://host.docker.internal:12283
IMMICH_API_KEY=
IMMICH_TIMEOUT_SECONDS=20
IMMICH_PROXY_MODE=backend
IMMICH_TUNNEL_PROXY_ENABLED=true
IMMICH_TUNNEL_PROXY_BIND_HOST=172.17.0.1
IMMICH_TUNNEL_PROXY_BIND_PORT=12283
IMMICH_TUNNEL_PROXY_TARGET_HOST=127.0.0.1
IMMICH_TUNNEL_PROXY_TARGET_PORT=12283
IMMICH_TUNNEL_PROXY_BACKLOG=64

# OIDC unified login (Authelia). OIDC_ENABLED=false disables the SSO routes.
OIDC_ENABLED=false
OIDC_ISSUER=https://auth.hydwang.xyz
OIDC_CLIENT_ID=website
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=https://hydwang.xyz/api/v1/auth/oidc/callback

# Local password login (/v1/auth/login, /v1/auth/register). Default true.
# After SSO cutover set to false so login goes only through Authelia OIDC.
# This flag is the break-glass switch: flip back to true (render + recreate
# backend) to restore password login if Authelia/lldap is unavailable.
LOCAL_LOGIN_ENABLED=true
