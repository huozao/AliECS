# Copy this file to /root/AliECS/deploy/ecs/release-meta.env and then edit values.
# If your ECS project directory is not /root/AliECS, update all paths below.
# release-meta.env is server-private config. Do not commit the real file.

APP_ROOT=/root/AliECS
COMPOSE_FILE=/root/AliECS/deploy/ecs/compose.prod.yml
RUNTIME_ENV_FILE=/root/AliECS/deploy/ecs/runtime.env
METADATA_DIR=/root/AliECS/deploy/ecs/.release-meta
MIGRATIONS_DIR=/root/AliECS/db/migrations

HEALTHCHECK_URL=http://127.0.0.1:8000/readyz
HEALTHCHECK_RETRIES=20
HEALTHCHECK_INTERVAL_SECONDS=3
DEPLOY_LOG_DIR=/root/AliECS/deploy/ecs/logs

GHCR_BASE=ghcr.io/huozao

# Required only when GHCR packages are private. Use a PAT with read:packages.
GHCR_USERNAME=
GHCR_TOKEN=

POSTGRES_USER=app
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=app
DATABASE_URL=postgresql://app:replace_with_strong_password@postgres:5432/app

# Generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=replace_with_secure_random_secret
AUTH_TOKEN_TTL_SECONDS=28800

# Used only when the users table is empty.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace_with_secure_password
ADMIN_BOOTSTRAP_DISPLAY_NAME=系统管理员

COUPLE_FEATURE_ENABLED=false
COUPLE_ROUTE=/couple/
COUPLE_ALLOWED_USERS=
COUPLE_ALLOWED_EMAILS=

# WeCom smartsheet sync. Real values stay only on ECS.
WECOM_ENV_PROFILES=COMPANY_A,COMPANY_B
WECOM_COMPANY_A_CORP_ID=
WECOM_COMPANY_A_APP_SECRET=
WECOM_COMPANY_A_APP_SECRET_2=
WECOM_COMPANY_A_APP_SECRETS=
WEDOC_COMPANY_A_DOCID=
WEDOC_COMPANY_A_SHEET_ID=
WEDRIVE_COMPANY_A_SPACEIDS=
SMARTSHEET_COMPANY_A_ID=
SMARTSHEET_COMPANY_A_SHEET_ID=
WECOM_COMPANY_B_CORP_ID=
WECOM_COMPANY_B_APP_SECRET=
WECOM_COMPANY_B_APP_SECRET_2=
WECOM_COMPANY_B_APP_SECRETS=
WEDOC_COMPANY_B_DOCID=
WEDOC_COMPANY_B_SHEET_ID=
WEDRIVE_COMPANY_B_SPACEIDS=
SMARTSHEET_COMPANY_B_ID=
SMARTSHEET_COMPANY_B_SHEET_ID=
