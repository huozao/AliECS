# 自建 Tailscale DERP 中继（txecs）的构建清单，由 .github/workflows/derp-deploy.yml 读取。
#
# 同一个版本号决定两样东西：
#   - tailscale / tailscaled：官方静态包 pkgs.tailscale.com/stable/tailscale_<ver>_amd64.tgz，
#     下面的 sha256 取自官方同名 .sha256 文件，不一致即构建失败；
#   - derper：按 tailscale.com/cmd/derper@v<ver> 源码编译。
#
# 设备侧还有一道版本闸（infra roles/server/derp/files/release.env），两边不一致时
# derp-deploy 拒绝安装。升级必须两处一起改，顺序见 infra roles/server/derp/README.md。
TAILSCALE_VERSION=1.102.4
TAILSCALE_TGZ_SHA256=50748df1045e60b5b695f19f4c56b0da36c019948b440fb456b6584a50f0d8b9
