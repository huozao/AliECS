# Example runtime env generated by deploy.sh.
# Production should normally edit /root/AliECS/deploy/ecs/release-meta.env instead.
# Do not commit the real runtime.env.

PUBLIC_WEB_IMAGE=ghcr.io/huozao/public-web:v0.1.0
ADMIN_UI_IMAGE=ghcr.io/huozao/admin-ui:v0.1.0
BACKEND_API_IMAGE=ghcr.io/huozao/backend-api:v0.1.0
DOC_SYNC_WORKER_IMAGE=ghcr.io/huozao/doc-sync-worker:v0.1.0
TPLUS_SYNC_WORKER_IMAGE=ghcr.io/huozao/tplus-sync-worker:v0.1.0
MCP_CODING_SERVER_IMAGE=ghcr.io/huozao/mcp-coding-server:v0.1.0

POSTGRES_USER=app
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=app
DATABASE_URL=postgresql://app:replace_with_strong_password@postgres:5432/app

AUTH_TOKEN_SECRET=replace_with_secure_random_secret
AUTH_TOKEN_TTL_SECONDS=28800

# 开发机 coding executor（阶段二 dry-run）。留空则 mcp-coding-server 编程工具优雅降级。
# EXECUTOR_BASE_URL 经反向 SSH 隧道回连开发机；EXECUTOR_TOKEN 两端需一致。
EXECUTOR_BASE_URL=
EXECUTOR_TOKEN=
EXECUTOR_TIMEOUT_SECONDS=20

ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace_with_secure_password
ADMIN_BOOTSTRAP_DISPLAY_NAME=系统管理员

COUPLE_FEATURE_ENABLED=false
COUPLE_ROUTE=/couple/
COUPLE_ALLOWED_USERS=
COUPLE_ALLOWED_EMAILS=

# COUPLE_ALLOWED_EMAILS uses comma-separated values, for example user1@example.com,user2@example.com.
# COUPLE_ALLOWED_USERS uses comma-separated usernames, for example admin,wh.
APP_BASE_URL=
SHARE_BASE_URL=https://www.hydwang.xyz
STORAGE_DRIVER=webdock
LOCAL_UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=15
WEBDOCK_PHOTO_BASE_URL=http://host.docker.internal:11800
WEBDOCK_PHOTO_API_TOKEN=
WEBDOCK_PHOTO_TIMEOUT_SECONDS=30
IMMICH_ENABLED=false
IMMICH_BASE_URL=https://immich.hydwang.xyz
IMMICH_API_KEY=
IMMICH_TIMEOUT_SECONDS=20
IMMICH_PROXY_MODE=backend
UPLOAD_DISK_WARN_PCT=90
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_TIMEOUT_SECONDS=30
UPLOAD_DRIVER=local
NAS_ORIGINAL_LIBRARY_PATH=
PHOTO_MAX_UPLOAD_MB=10
THUMBNAIL_WIDTH=1200
THUMBNAIL_QUALITY=85
SHARE_LINK_SECRET=
SESSION_SECRET=

# WeCom smartsheet sync. Example file only uses placeholders.
WECOM_ENV_PROFILES=COMPANY_A,COMPANY_B
WECOM_COMPANY_A_CORP_ID=
WECOM_COMPANY_A_APP_SECRET=
WECOM_COMPANY_A_APP_SECRET_2=
WECOM_COMPANY_A_APP_SECRETS=
WEDOC_COMPANY_A_DOCID=
WEDOC_COMPANY_A_NAME=
WEDOC_COMPANY_A_SHEET_ID=
WEDRIVE_COMPANY_A_SPACEIDS=
SMARTSHEET_COMPANY_A_ID=
SMARTSHEET_COMPANY_A_NAME=
SMARTSHEET_COMPANY_A_SHEET_ID=
WECOM_COMPANY_B_CORP_ID=
WECOM_COMPANY_B_APP_SECRET=
WECOM_COMPANY_B_APP_SECRET_2=
WECOM_COMPANY_B_APP_SECRETS=
WEDOC_COMPANY_B_DOCID=
WEDOC_COMPANY_B_NAME=
WEDOC_COMPANY_B_SHEET_ID=
WEDRIVE_COMPANY_B_SPACEIDS=
SMARTSHEET_COMPANY_B_ID=
SMARTSHEET_COMPANY_B_NAME=
SMARTSHEET_COMPANY_B_SHEET_ID=

# Feishu bitable sync. Example file only uses placeholders.
FEISHU_ENV_PROFILES=COMPANY_A,COMPANY_B
FEISHU_COMPANY_A_APP_ID=
FEISHU_COMPANY_A_APP_SECRET=
FEISHU_COMPANY_A_APP_TOKEN=
FEISHU_COMPANY_A_TABLE_ID=
FEISHU_COMPANY_A_VIEW_ID=
FEISHU_COMPANY_A_WIKI_NODE_TOKEN=
FEISHU_COMPANY_A_WIKI_URL=
FEISHU_COMPANY_A_APP_NAME=
FEISHU_COMPANY_A_TABLE_NAME=
FEISHU_COMPANY_B_APP_ID=
FEISHU_COMPANY_B_APP_SECRET=
FEISHU_COMPANY_B_APP_TOKEN=
FEISHU_COMPANY_B_TABLE_ID=
FEISHU_COMPANY_B_VIEW_ID=
FEISHU_COMPANY_B_WIKI_NODE_TOKEN=
FEISHU_COMPANY_B_WIKI_URL=
FEISHU_COMPANY_B_APP_NAME=
FEISHU_COMPANY_B_TABLE_NAME=

# Chanjet webhook gateway placeholders only. Real values stay only on ECS.
CHANJET_BASE_URL=https://openapi.chanjet.com
CHANJET_APP_KEY=
CHANJET_APP_SECRET=
CHANJET_OPEN_TOKEN=
CHANJET_WEBHOOK_AES_KEY=
CHANJET_EVENT_SPOOL_DIR=/tmp/aliecs-integration-events/chanjet
CHANJET_AUTO_EXCHANGE_OAUTH_CODE=false

# T+ sync worker. The first run starts immediately, then repeats by interval.
DEFAULT_PAGE_SIZE=500
REQUEST_TIMEOUT_CONNECT=5
REQUEST_TIMEOUT_READ=30
TPLUS_SYNC_INTERVAL_SECONDS=86400
TPLUS_SYNC_POLL_SECONDS=30
TPLUS_DB_SYNC_REQUESTS_ENABLED=true
OPS_HEALTH_HTTP_TARGETS_JSON=

# Recipe query reads the T+ worker output volume read-only and writes generated files to a temp dir.
RECIPE_BOM_INPUT_DIR=/app/tplus-output/excel
RECIPE_BOM_INPUT_GLOB=*物料清单合并*.xlsx;*bom*.xlsx;*物料清单*.xlsx
RECIPE_ACTIVE_BOM_DIR=/app/recipe-active-bom
RECIPE_EXPORT_DIR=/tmp/aliecs-recipe-exports
TPLUS_BOM_SYNC_REQUEST_DIR=/app/tplus-sync-requests

# --- MCP coding OAuth (Phase 4) ---
MCP_OAUTH_ENABLED=false
MCP_OAUTH_ISSUER=
MCP_OAUTH_PASSPHRASE=
MCP_OAUTH_SIGNING_SECRET=
MCP_OAUTH_STORE_PATH=/data/oauth/oauth.db
MCP_OAUTH_ACCESS_TTL=3600
MCP_OAUTH_REFRESH_TTL=2592000
MCP_OAUTH_CODE_TTL=600
