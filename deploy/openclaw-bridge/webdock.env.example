WEB_DOCK_BASE_URL=http://127.0.0.1:11800/v1
WEB_DOCK_API_TOKEN=replace_with_long_random_api_token
WEB_DOCK_MODEL=browser-chatgpt
# Must outlast WebDock's chat_timeout_seconds (prod runtime override ~300s) so
# the bridge waits for the real reply instead of timing out first.
WEB_DOCK_TIMEOUT_SECONDS=320
# Seconds between SSE keepalive chunks while ChatGPT is still working; keep well
# under OpenClaw's ~120s idle timeout so it does not cut the connection.
OPENCLAW_BRIDGE_KEEPALIVE_SECONDS=15
# Normal same-lane batching window for adjacent WeChat turns.
OPENCLAW_BRIDGE_BATCH_SECONDS=2
# When the text clearly asks to edit/analyze a following image and no image has
# arrived yet, wait longer before sending the text alone to ChatGPT.
OPENCLAW_BRIDGE_MEDIA_INTENT_BATCH_SECONDS=8
# After text and image have both joined one batch, wait this long for adjacent
# media before flushing to WebDock.
OPENCLAW_BRIDGE_BATCH_SETTLE_SECONDS=0.35
OPENCLAW_BRIDGE_HOSTS=127.0.0.1
OPENCLAW_BRIDGE_PORT=18080
WEB_DOCK_FALLBACK_MESSAGE=ChatGPT 浏览器暂不可用，请稍后再试。
