WEB_DOCK_BASE_URL=http://127.0.0.1:11800/v1
WEB_DOCK_API_TOKEN=replace_with_long_random_api_token
WEB_DOCK_MODEL=browser-chatgpt
# Must outlast WebDock's chat_timeout_seconds (prod runtime override ~300s) so
# the bridge waits for the real reply instead of timing out first.
WEB_DOCK_TIMEOUT_SECONDS=320
# Seconds between SSE keepalive chunks while ChatGPT is still working; keep well
# under OpenClaw's ~120s idle timeout so it does not cut the connection.
OPENCLAW_BRIDGE_KEEPALIVE_SECONDS=15
# Normal same-lane batching window for adjacent WeChat turns.
OPENCLAW_BRIDGE_BATCH_SECONDS=2
# When the text clearly asks to edit/analyze a following image and no image has
# arrived yet, wait longer before sending the text alone to ChatGPT.
OPENCLAW_BRIDGE_MEDIA_INTENT_BATCH_SECONDS=8
# After text and image have both joined one batch, wait this long for adjacent
# media before flushing to WebDock.
OPENCLAW_BRIDGE_BATCH_SETTLE_SECONDS=0.35
OPENCLAW_BRIDGE_HOSTS=127.0.0.1
OPENCLAW_BRIDGE_PORT=18080
WEB_DOCK_FALLBACK_MESSAGE=ChatGPT 浏览器暂不可用，请稍后再试。

# Feishu ChatGPT session console. The Feishu self-built app credentials are
# reused; these values identify the Bitable app/tables and default ChatGPT
# project used for /新对话 routing.
FEISHU_SESSION_CONSOLE_APP_TOKEN=replace_with_bitable_app_token
FEISHU_SESSION_CONSOLE_MESSAGE_TABLE_ID=replace_with_message_table_id
FEISHU_SESSION_CONSOLE_TASK_TABLE_ID=replace_with_task_table_id
FEISHU_SESSION_CONSOLE_SESSION_TABLE_ID=replace_with_session_table_id
FEISHU_SESSION_CONSOLE_CHATGPT_PROJECT_URL=https://chatgpt.com/g/g-p-6a2ffe0bac248191988612d9081dd6b1-lark-hao/project
FEISHU_SESSION_CONSOLE_CHATGPT_PROJECT_NAME=飞书AI会话台

# Cache TTL for the bitable-driven group policy lookup (回复模式 / 是否启用机器人).
# Default 600s. Raise (e.g. 3600+) once the bitable automation -> /admin/
# invalidate-feishu-group-policy webhook is wired up, since manual edits then
# push-invalidate the cache instead of waiting it out.
OPENCLAW_BRIDGE_FEISHU_POLICY_CACHE_SECONDS=600
# Shared secret guarding /admin/invalidate-feishu-group-policy. If unset, the
# endpoint returns 403 (disabled). Set this AND configure the bitable
# automation's HTTP action to send it as the X-Admin-Secret header.
OPENCLAW_BRIDGE_ADMIN_SECRET=replace_with_long_random_admin_secret

# --- 多维表格常驻快照 -------------------------------------------------------
# 消息路径不再同步扫多维表格：后台线程按周期把用到的表全量刷进内存快照，读走内存。
# 刷新周期，也就是"你改了表到生效"的上限（秒）。这是唯一一个「飞书 API 调用量 ↔
# 配置生效速度」的旋钮：轮询 N 张表、周期 T 秒 = 每天 86400/T*N 次请求（不管有没有
# 变化）。60s/4 张表 ≈ 每分钟 4 次，远低于租户限额。调小只增调用量，不改消息延迟
# （消息读的是内存）。
FEISHU_BITABLE_SNAPSHOT_REFRESH_SECONDS=60
# 快照可用上限（秒）。不是新鲜度目标（那是刷新周期），而是"刷新线程死了"的兜底：
# 超过这个岁数就不再拿快照回答，退回同步扫表，让真实错误浮出来。
FEISHU_BITABLE_LIST_CACHE_SECONDS=900
# 快照落盘位置，容器重启（cutover）后第一条消息不必再付冷扫描。
# 需要 compose 挂一个可写目录（infra roles/server/tencent/files/compose.openclaw-bridge.yml）。
FEISHU_BITABLE_SNAPSHOT_PATH=/var/lib/openclaw-bridge/bitable-snapshot.json
# 每日全量核对的本地时间（容器 TZ），挑空闲时段，会把所有表连着重扫一遍。
FEISHU_BITABLE_RECONCILE_AT=04:00
# 核对发现异常时告警到哪个飞书群会话。
FEISHU_ALERT_CHAT_ID=oc_84d1130542509e374f7ea20c13d11ca4
