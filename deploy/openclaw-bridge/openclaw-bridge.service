[Unit]
Description=OpenClaw local WebDock bridge
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/openclaw-bridge/openclaw_bridge.py
Restart=always
RestartSec=3
User=root
WorkingDirectory=/opt/openclaw-bridge
EnvironmentFile=-/opt/openclaw-bridge/webdock.env

[Install]
WantedBy=multi-user.target
