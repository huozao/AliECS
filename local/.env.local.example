# 本地模拟验证环境变量示例。
# 使用前请复制为 local/.env.local。
# local/.env.local 只能保存本地测试值，不得提交 GitHub。
# 不要从 ECS、deploy/ecs/runtime.env 或 deploy/ecs/release-meta.env 复制生产密钥。

APP_ENV=local
DATABASE_URL=postgresql://app:app@postgres:5432/app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
AUTH_TOKEN_SECRET=local-dev-secret-change-in-prod
AUTH_TOKEN_TTL_SECONDS=28800
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123
ADMIN_BOOTSTRAP_DISPLAY_NAME=系统管理员
COUPLE_FEATURE_ENABLED=true
COUPLE_ROUTE=/couple/
COUPLE_ALLOWED_USERS=admin
COUPLE_ALLOWED_EMAILS=

# 企业微信智能表格本地同步配置。这里只能填写本地测试值或空值，不要复制生产密钥。
WECOM_ENV_PROFILES=COMPANY_A,COMPANY_B
WECOM_COMPANY_A_CORP_ID=
WECOM_COMPANY_A_APP_SECRET=
WECOM_COMPANY_A_APP_SECRET_2=
WECOM_COMPANY_A_APP_SECRETS=
WEDOC_COMPANY_A_DOCID=
WEDOC_COMPANY_A_SHEET_ID=
WEDRIVE_COMPANY_A_SPACEIDS=
SMARTSHEET_COMPANY_A_ID=
SMARTSHEET_COMPANY_A_SHEET_ID=
WECOM_COMPANY_B_CORP_ID=
WECOM_COMPANY_B_APP_SECRET=
WECOM_COMPANY_B_APP_SECRET_2=
WECOM_COMPANY_B_APP_SECRETS=
WEDOC_COMPANY_B_DOCID=
WEDOC_COMPANY_B_SHEET_ID=
WEDRIVE_COMPANY_B_SPACEIDS=
SMARTSHEET_COMPANY_B_ID=
SMARTSHEET_COMPANY_B_SHEET_ID=

# Chanjet webhook gateway placeholders only.
CHANJET_BASE_URL=https://openapi.chanjet.com
CHANJET_APP_KEY=
CHANJET_APP_SECRET=
CHANJET_OPEN_TOKEN=
CHANJET_WEBHOOK_AES_KEY=
CHANJET_EVENT_SPOOL_DIR=/tmp/aliecs-integration-events/chanjet
CHANJET_AUTO_EXCHANGE_OAUTH_CODE=false

# Optional local T+ sync worker profile: docker compose --profile tplus ...
DEFAULT_PAGE_SIZE=500
REQUEST_TIMEOUT_CONNECT=5
REQUEST_TIMEOUT_READ=30
TPLUS_SYNC_INTERVAL_SECONDS=3600
